  nombrePorDefecto: 
  dialogos:
  - nombrePersonaje: 
    texto: Bienvenido a ninguna parte.
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: Un lugar para ser feliz.
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: "Un lugar para ser est\xFApido."
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: "Porque no siempre ten\xE9s que pensar."
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: "Hay que volverse m\xE1s est\xFApido."
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: "M\xE1s feliz."
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: "Como \xE9l\u2026"
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: "M\xE1s est\xFApido."
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: "M\xE1s primitivo."
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: Tu belleza no es que tanto te esforzas en ser inteligente.
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: Porque ya sos inteligente.
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: "Lo que te falta\u2026"
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: ...Es ser feliz.
    imagen: {fileID: 0}
