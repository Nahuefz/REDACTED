  nombrePorDefecto: Cubo
  dialogos:
  - nombrePersonaje: 
    texto: Hola Galo! Como estas?
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: Este espacio va a ser el segundo puzzle. Un espacio infinito donde tengo
      que interactuar con otros personajes.
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: Solo esta hecho el loop para que parezca infinito.
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: "Pero la idea es a\xF1adir mas personajes y un acertijo de quien tiene
      el objeto para robarselo."
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: Cualquier duda me puede preguntar por ds o mail!
    imagen: {fileID: 0}
