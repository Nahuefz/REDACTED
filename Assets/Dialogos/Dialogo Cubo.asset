  nombrePorDefecto: Cubo
  dialogos:
  - nombrePersonaje: 
    texto: Yo soy un Cubo, pero cuando los desarrolladores se pongan las pilas, quiero
      ser arquitecto!
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: Ahora mismo solo existo.
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: En algun momento te dare algo importante, pero por ahora, no hay nada!
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: Hay que arreglar ese temita tambien.... Pero eu, te gusto el truquito,
      no?
    imagen: {fileID: 0}
