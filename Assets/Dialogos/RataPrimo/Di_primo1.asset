  nombrePorDefecto: 
  dialogos:
  - nombrePersonaje: 
    texto: Pasa tranquilo, que aca somos todos amigos.
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: Te mando Cindy? Nunca se rinde eh...
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: No esta tan facil la cosa aca abajo. Si te descubren fuiste!
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: Escuchame. Queres salir? Traeme lo que te pido y yo te saco.
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: 'Necesito un frasco de nitroglicerina, aserrin y un mapa de estos tuneles. '
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: Una papa. Yo no me puedo meter a esas habitaciones a buscarla, muy peligroso.
    imagen: {fileID: 0}
  - nombrePersonaje: 
    texto: Capaz vos tenes mas suerte...
    imagen: {fileID: 0}
